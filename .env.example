# Copy this file to .env (in the hw4 folder) and fill in your own values.
# Never commit the real .env file.

# Required: your Portkey API key for the shop assistant
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown)
PORTKEY_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key-here

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Optional: write the audit trail somewhere other than output/audit_trail.json
# AUDIT_TRAIL_PATH=output/audit_trail.json
